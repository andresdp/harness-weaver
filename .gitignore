.DS_Store

# Local secrets
.env
.env.*
!.env.example

# Local Claude Code permissions and machine-specific settings
.claude/settings.local.json
.claude/settings.local.*.json

# Local reference library and external case-study snapshots (cite/link in docs)
/papers/
/case-studies/architecture-eval/
/case-studies/atam-evaluator/

# Python-generated files
__pycache__/
*.py[cod]
*.egg-info/

# Local ATAM reasoning traces and protocol smoke run
case-studies/architecture-eval/ATAM/logs/**/*.log
pilots/atam/deepagents/runs/
benchmarks/atam/runs/
benchmarks/saam/runs/.review-keys/

# Standalone repositories; keep their histories separate from this repository
case-studies/software-architecture-agent/
/pilots/sara/sources/harvest-input/
# Local SARA bundles repeat third-party workflow source text; keep them out of public history.
/pilots/sara/generated/
/pilots/sara/cases/
/.agents
skills-lock.json
/benchmarks/saam/runs
