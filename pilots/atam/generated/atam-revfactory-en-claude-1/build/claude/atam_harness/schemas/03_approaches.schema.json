{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AtamApproachesArtifact",
  "description": "Stage 3 (identify-approaches) output: 03_approaches.json. Approaches (AP-n) are grounded in AE-n evidence; an approach named by the inputs is observed, an approach recognised by reasoning over evidence is inferred and carries an inference_note.",
  "$defs": {
    "Gap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^G-3-[0-9]+$"},
        "gap_type": {"type": "string", "enum": ["unknown", "conflict", "incomplete", "assumption"]},
        "description": {"type": "string", "minLength": 1},
        "affected_activity": {"type": "string", "enum": ["establish-context", "build-utility-tree", "identify-approaches", "analyze-scenarios", "synthesize-and-review"]},
        "missing_evidence": {"type": "string", "minLength": 1},
        "resolution_question": {"type": "string", "minLength": 1}
      },
      "required": ["id", "gap_type", "description", "affected_activity", "missing_evidence", "resolution_question"]
    },
    "EvidenceIds": {"type": "array", "items": {"type": "string", "pattern": "^AE-[0-9]+$"}, "minItems": 1}
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "approaches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^AP-[0-9]+$"},
          "approach_name": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "basis": {"type": "string", "enum": ["observed", "inferred"]},
          "inference_note": {"type": ["string", "null"], "description": "Required (non-empty) when basis is inferred: the reasoning from the cited evidence to the approach."},
          "evidence_ids": {"$ref": "#/$defs/EvidenceIds"},
          "addressed_attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "quality_attribute": {"type": "string", "minLength": 1},
                "rationale": {"type": "string", "minLength": 1},
                "basis": {"type": "string", "enum": ["observed", "inferred"]},
                "evidence_ids": {"$ref": "#/$defs/EvidenceIds"}
              },
              "required": ["quality_attribute", "rationale", "basis", "evidence_ids"]
            }
          }
        },
        "required": ["id", "approach_name", "description", "basis", "inference_note", "evidence_ids", "addressed_attributes"]
      }
    },
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/Gap"}}
  },
  "required": ["approaches", "gaps"]
}
